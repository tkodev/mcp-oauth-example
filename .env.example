# Port the MCP server listens on.
PORT=3000

# Public base URL of THIS resource server (used to advertise metadata and to
# validate the `aud`/`resource` of incoming access tokens per RFC 8707).
MCP_SERVER_URL=http://localhost:3000

# The external OAuth 2.1 authorization server that issues access tokens.
# The MCP server points clients here via Protected Resource Metadata (RFC 9728)
# and validates tokens against its JWKS.
AUTH_ISSUER_URL=https://auth.example.com
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Expected audience for access tokens. Should equal MCP_SERVER_URL.
AUTH_AUDIENCE=http://localhost:3000
